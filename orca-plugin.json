{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "activity-calendar",
  "publisher": "bhojanibilal24",
  "name": "Calendario de actividad",
  "version": "0.1.4",
  "description": "Un calendario de actividad en la barra lateral para Codex y Claude: bloques de trabajo, agentes en paralelo, nombres de hilo de Orca, resúmenes de trabajo y hojas de horas en CSV. Lee el historial local; sin servicios externos.",
  "license": "MIT",
  "repository": "https://github.com/bhojanibilal24/orca-activity-calendar",
  "engines": { "orca": ">=1.4.246" },
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "contributes": {
    "panels": [
      { "id": "calendar", "title": "Calendario de actividad", "icon": "calendar", "entry": "web/panel.html", "ui": "html" }
    ],
    "commands": [
      { "id": "calendar.refresh", "title": "Calendario de actividad: actualizar historial", "when": "global" }
    ],
    "events": [{ "on": "agent.status.changed" }]
  },
  "capabilities": [{ "kind": "agent:read" }, { "kind": "storage:own" }]
}
